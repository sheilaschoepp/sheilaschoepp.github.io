@article{Schoepp2026ContinualRL,
  author       = {Sheila Schoepp and
                  Taghian Jazi, Mehran and
                  Mohamadali Tofigh and
                  Shotaro Miwa and
                  Yoshihiro Mitsuka and
                  Osmar Zaiane},
  title        = {A Continual Reinforcement Learning Framework for Embodied Agent Adaptation under Hardware Faults},
  journal      = {Under Review},
  year         = {2026},
  month        = {10},
  day          = {08},
  abbr={Under Review},
  abstract={Industry is moving toward autonomous, network-connected agents that detect and adapt to changing conditions, including hardware faults. Reinforcement learning (RL) has shown promise for continual adaptation in autonomous systems. This paper introduces a continual RL pipeline for robotic fault adaptation. The framework includes three stages: learning a policy under normal operation, introducing a hardware fault, and adapting to the corresponding failure mode. We investigate established algorithms for time-series sensor-input control, e.g., Proximal Policy Optimization (PPO) and Soft Actor-Critic (SAC), and four knowledge-transfer strategies: retaining or discarding model parameters, and retaining or discarding storage contents. Our results on two benchmarks in Gymnasium environments, Ant-v5 and FetchReachDense-v4, show fault-specific adaptation with clear trade-offs. In Ant-v5, retaining PPO's parameters boosts early returns across all faults, while the effect of retaining SAC's parameters at fault onset varies with the fault. With SAC's parameters retained, clearing the replay buffer improves early returns in three of the four Ant faults. After 2,000 time steps in FetchReachDense-v4, discarding PPO's and SAC's parameters improves performance with the frozen sensor, whereas retaining them improves performance with the biased sensor. Both algorithms improve post-fault returns with continued learning, with outcomes depending on the fault and knowledge-transfer strategy.}
}
}

