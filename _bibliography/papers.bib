@article{Mallahnezhad2026TowardsDC,
  author       = {Mahdieh Mallahnezhad and
                  Masoud Jafaripour and
                  Mohamadali Tofigh and
                  Sheila Schoepp and
                  Osmar R. Zaiane},
  title        = {Towards a Data-Centric Understanding of Spatial Reasoning in Multimodal Large Language Models},
  journal      = {Under Review},
  year         = {2026},
  month        = {09},
  day          = {26},
  abbr={Under Review},
  bibtex_show={true},
  preview={Mallahnezhad2026TowardsDC.png},
  abstract={Multimodal Large Language Models (MLLMs) have been widely applied in embodied agents and robotics for vision tasks. However, MLLMs suffer from limitations in spatial reasoning and perception. Post-training techniques have shown promise for improving these capabilities; yet, there are limited data-driven surveys of such approaches. In this survey, we consider approaches to fine-tuning pretrained MLLMs for spatial reasoning tasks, ranging from supervised to reinforcement learning, with an emphasis on the datasets used. We investigate themes of dataset construction, data modality and annotation, and evaluation of the resulting models. Based on these themes, we categorize research into three groups: dataset design, dataset construction and evaluation. We find four main methods for constructing fixed spatial annotations: rules and templates, LLM prompting, procedural generation, and human-in-the-loop. We also observe substantial variation in evaluation approaches, including different scoring methods, tolerance metrics, and benchmark types. Finally, we identify opportunities for future research in unified dynamic annotation, efficient spatial reasoning, standardization of evaluation, expanded spatial range, and human-centered spatial interactions.}
}

}

@inproceedings{Schoepp2025TheEL,
  title={The Evolving Landscape of LLM{-} and VLM{-}Integrated Reinforcement Learning},
  author={Sheila Schoepp and Masoud Jafaripour{*} and Yingyue Cao{*} and Tianpei Yang and Fatemeh Abdollahi and Shadan Golestan and Zahin Sufiyan and Osmar R. Zaiane and Matthew E. Taylor},
  booktitle={IJCAI},
  abbr={IJCAI},
  bibtex_show={true},
  year={2025},
  annotation={{*}Equal contribution},
  preview={Schoepp2025TheEL.png},
  abstract={Reinforcement learning (RL) has shown impressive results in sequential decision-making tasks. Meanwhile, Large Language Models (LLMs) and Vision-Language Models (VLMs) have emerged, exhibiting impressive capabilities in multimodal understanding and reasoning. These advances have led to a surge of research integrating LLMs and VLMs into RL. In this survey, we review representative works in which LLMs and VLMs are used to overcome key challenges in RL, such as lack of prior knowledge, long-horizon planning, and reward design. We present a taxonomy that categorizes these LLM/VLM-assisted RL approaches into three roles: agent, planner, and reward. We conclude by exploring open problems, including grounding, bias mitigation, improved representations, and action advice. By consolidating existing research and identifying future directions, this survey establishes a framework for integrating LLMs and VLMs into RL, advancing approaches that unify natural language and visual understanding with sequential decision-making.},
  doi={10.24963/ijcai.2025/1181},
  pdf={https://www.ijcai.org/proceedings/2025/1181.pdf},
  poster={Schoepp2025TheEL.pdf}
}

