@article{Mallahnezhad2026TeachingST,
  author       = {Mahdieh Mallahnezhad and
                  Sheila Schoepp and
                  Mohamadali Tofigh and
                  Matthew E. Taylor and
                  Osmar Zaiane},
  title        = {Teaching in the Student's Terms: {LLM} Explanations as Executable Advice for Reinforcement Learning},
  journal      = {Under Review},
  year         = {2026},
  month        = {10},
  day          = {08},
  abbr={Under Review},
  abstract={Reinforcement learning (RL) uses rewards to teach agents, but learning can be slow, and in sparse reward and partly observable environments, learning may not occur within a limited training budget. Large language models (LLMs) have significant domain knowledge of these types of environments. A natural question arises then: how can a more knowledgeable teacher convey its domain knowledge such that it can be used by a less capable learner? We provide explanations that can be used by the learner. An LLM generates a small number of executable rules prior to training. Each rule suggests an action and provides conditions for when the action should be taken. The conditions within a rule refer to the learner's local observations and, where needed, information about its own task progress. These rules provide auxiliary information during training. The learner acts independently in both action selection and final behavior while the rules serve as guidance during training. We compare a plain Proximal Policy Optimization (PPO) and an exploration based learner (PPO with counting based exploration) in two partially observable task domains: navigation and object interaction tasks. Using explanations, we are able to enable the naive learner to solve tasks that would not be learned using only reward signals within the tested budget and improve upon the performance of the exploration-based learner on selected tasks. Rules generated for small environments can also be applied unchanged to larger environments with failure results becoming successful. Since the rules are generated once and can be reused, there is no additional need for the LLM during training, and the approach requires little LLM computation beyond the initial teaching stage. We present explanations as a feasible and inexpensive mechanism for transferring language model knowledge to reinforcement learning algorithms.}
}
}

